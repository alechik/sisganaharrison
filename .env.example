# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# ============================================================
# Este archivo es una plantilla para configurar el entorno.
# NO colocar aquí credenciales, claves o secretos reales.
# El archivo .env es local y está excluido del repositorio Git.
# APP_KEY debe generarse/configurarse en el entorno local.
# ============================================================

# ============================================================
# .env - SISGANADERIA (raíz del proyecto)
# ============================================================
# Este archivo lo lee docker-compose.yml:
#   1. Como "env_file" del servicio backend (variables de Laravel)
#   2. Para sustitución de ${VARIABLE} en el propio compose
#
# Copia este archivo a ".env" y ajusta los valores:
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows CMD)
#   Copy-Item .env.example .env   (PowerShell)
# ============================================================

# ---------- BASE DE DATOS ----------
DB_CONNECTION=pgsql
DB_DATABASE=sisganaderia
DB_USERNAME=postgres
DB_PASSWORD=secret

# ---------- PUERTO DEL REVERSE PROXY (nginx) ----------
# Puerto del host que publica la app completa (frontend + API).
# Cámbialo si el 80 ya está ocupado, p.ej. 8080
NGINX_PORT=80

# ---------- FRONTEND (Vite) ----------
# Vite "quema" esta variable en el bundle durante el build.
# "/api" = misma origen, el proxy nginx la reenvía al backend.
# Si la cambias, reconstruye:  docker compose build --no-cache frontend
VITE_API_URL=/api
VITE_APP_NAME=SisGanaderia

# ---------- BACKEND (Laravel) ----------
APP_NAME=SisGanaderia
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=

# Ejecuta los seeders la primera vez que arranca el contenedor.
# Deja el marcador storage/app/.seeded para no repetirlos.
# Usuarios demo (password: 12345678):
#   admin@gmail.com · gerencia@gmail.com · trabajador@gmail.com · vet@gmail.com
DB_SEED=true

# ---------- MISCELÁNEA ----------
TZ=America/Mexico_City
